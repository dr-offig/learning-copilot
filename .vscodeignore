# Everything the extension actually runs from lives in dist/ (see "main"),
# bundled by esbuild. Nothing below is needed at runtime.

# --- Source and build tooling ---
src/**
out/**
scripts/**
node_modules/**
esbuild.js
**/tsconfig.json
**/eslint.config.mjs
**/*.ts
**/*.map

# --- Local working files ---
# Figma imports and their generated output are per-project, not something to
# ship: report.json and FIGMA_DESIGN.md are dumps of whatever design was last
# imported while testing.
report.json
tokens.css
probe.js
FIGMA_DESIGN.md
tmp/**
.learning-copilot/**

# --- Editor and test harness ---
.vscode/**
.vscode-test/**
**/.vscode-test.*

# --- Repo and local tooling config ---
.git/**
.gitignore
.gitattributes
.yarnrc
.claude/**
package-lock.json
vsc-extension-quickstart.md

# --- Build artifacts and OS cruft ---
*.vsix
**/.DS_Store

# --- Assets: ship the packaged icon only, not the editable source ---
images/**
!images/icon.png
