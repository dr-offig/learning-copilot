# Everything the extension actually runs from lives in dist/ (see "main"),
# bundled by esbuild. Nothing below is needed at runtime.

# --- Source and build tooling ---
src/**
out/**
scripts/**
node_modules/**
esbuild.js
**/tsconfig.json
**/eslint.config.mjs
**/*.ts
**/*.map

# --- Local working files ---
# Figma imports and their generated CSS are per-project output, not something
# to ship: report.json in particular is a dump of whatever design system was
# last imported.
report.json
tokens.css
.learning-copilot/**

# --- Editor and test harness ---
.vscode/**
.vscode-test/**
**/.vscode-test.*

# --- Repo and local tooling config ---
.git/**
.gitignore
.gitattributes
.yarnrc
.claude/**
package-lock.json
vsc-extension-quickstart.md

# --- Build artifacts and OS cruft ---
*.vsix
**/.DS_Store

# --- Assets: ship the packaged icon only, not the editable source ---
images/**
!images/icon.png
