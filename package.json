{
  "name": "learning-copilot",
  "publisher": "dr-offig",
  "displayName": "learning-copilot",
  "description": "AI code generator that creates learning tasks and exercises",
  "version": "0.0.6",
  "repository" : {
    "type": "git",
    "url": "https://github.com/dr-offig/learning-copilot.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#4E6E92",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "learningCopilot.showMenu", "title": "Learning Copilot: Open Menu", "icon": "$(mortar-board)" },
      { "command": "learningCopilot.generateFromPrompt", "title": "Learning Copilot: Create or Update Project from Prompt" },
      { "command": "learningCopilot.analyzeDesignFiles", "title": "Learning Copilot: Analyze Design Files" },
      { "command": "learningCopilot.openExercises", "title": "Learning Copilot: Open Learning Exercises" },
      { "command": "learningCopilot.compareWithSolution", "title": "Learning Copilot: Compare Active File With Solution"},
      { "command": "learningCopilot.applyTaskAtCursor", "title": "Learning Copilot: Apply Solution For Task At Cursor" },
      { "command": "learningCopilot.applyNextTask", "title": "Learning Copilot: Apply Solution For Next Task" },
      { "command": "learningCopilot.applyAllTasks", "title": "Learning Copilot: Apply Solution For All Tasks" },
      { "command": "learningCopilot.showHintForTaskAtCursor", "title": "Learning Copilot: Show Hint For Task At Cursor" },
      { "command": "learningCopilot.markTaskDoneAtCursor", "title": "Learning Copilot: Mark Task As Done At Cursor" },
      { "command": "learningCopilot.openLatestAnswerKey", "title": "Learning Copilot: Open Latest Answer Key" },
      { "command": "learningCopilot.installCopilotCli", "title": "Learning Copilot: Install/Setup Copilot CLI" },
      { "command": "learningCopilot.loginCopilotCli", "title": "Learning Copilot: Login to Copilot CLI" },
      { "command": "learningCopilot.logoutCopilotCli", "title": "Learning Copilot: Logout of Copilot CLI" },
      { "command": "learningCopilot.showCopilotCliDetails", "title": "Learning Copilot: Show Copilot CLI Details" },
      { "command": "learningCopilot.setCopilotCliPath", "title": "Learning Copilot: Set Copilot CLI Path" }
    ],
    "keybindings": [
      { "command": "learningCopilot.showMenu", "key": "ctrl+alt+l" },
      { "command": "learningCopilot.openExercises", "key": "ctrl+alt+x" },
      { "command": "learningCopilot.showHintForTaskAtCursor", "key": "ctrl+alt+h", "when": "editorTextFocus && learningCopilot.taskAtCursor" },
      { "command": "learningCopilot.markTaskDoneAtCursor", "key": "ctrl+alt+m", "when": "editorTextFocus && learningCopilot.taskAtCursor" },
      { "command": "learningCopilot.applyTaskAtCursor", "key": "ctrl+alt+a", "when": "editorTextFocus && learningCopilot.taskAtCursor" },
      { "command": "learningCopilot.applyNextTask", "key": "ctrl+alt+n", "when": "editorTextFocus" },
      { "command": "learningCopilot.compareWithSolution", "key": "ctrl+alt+s", "when": "editorTextFocus" }
    ],
    "menus": {
      "editor/context": [
        { "command": "learningCopilot.showHintForTaskAtCursor", "when": "learningCopilot.taskAtCursor", "group": "learningCopilot@1" },
        { "command": "learningCopilot.markTaskDoneAtCursor", "when": "learningCopilot.taskAtCursor", "group": "learningCopilot@2" },
        { "command": "learningCopilot.applyTaskAtCursor", "when": "learningCopilot.taskAtCursor", "group": "learningCopilot@3" }
      ]
    },
    "configuration": {
      "title": "Learning Copilot",
      "properties": {
        "learningCopilot.copilotPath": {
          "type": "string",
          "default": "copilot",
          "description": "Path to Copilot CLI executable (e.g., 'copilot' on macOS, or 'C:\\\\Users\\\\you\\\\copilot.exe' on Windows lab machines)."
        },
        "learningCopilot.autoInstallCopilotCli": {
          "type": "boolean",
          "default": true,
          "description": "If true, Learning Copilot can offer to install Copilot CLI automatically when it is missing."
        },
        "learningCopilot.copilotArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra args passed to Copilot CLI."
        },
        "learningCopilot.transport": {
          "type": "string",
          "enum": ["auto", "languageModelApi", "copilotCli"],
          "default": "auto",
          "enumDescriptions": [
            "Use the VS Code Language Model API when a Copilot model is available (requires the GitHub Copilot Chat extension), otherwise fall back to the Copilot CLI.",
            "Always use the VS Code Language Model API (requires the GitHub Copilot Chat extension, signed in).",
            "Always use the Copilot CLI."
          ],
          "description": "How Learning Copilot talks to the model."
        },
        "learningCopilot.modelFamily": {
          "type": "string",
          "default": "",
          "description": "Preferred model family for the Language Model API (e.g. 'gpt-4o'). Leave empty to pick the available Copilot model with the largest context window."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
